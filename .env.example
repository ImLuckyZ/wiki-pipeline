# Copy this file to .env and fill in your own values.
# .env is ignored by git; .env.example is committed.

# Contact info sent to Wikimedia in the User-Agent header
# (a GitHub repo URL or an email you don't mind being visible to Wikimedia)
WIKI_CONTACT=https://github.com/your-username/wiki-pipeline

# Local development database credentials
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wiki
